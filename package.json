{
  "name": "review-guide",
  "displayName": "Review Guide",
  "description": "Pre-sorts a GitHub pull request with Claude, so you review the critical changes first and know what to check at each one.",
  "version": "0.1.0",
  "publisher": "gapsong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gapsong/review-guide.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviewGuide",
          "title": "Review Guide",
          "icon": "media/review-guide.svg"
        }
      ]
    },
    "views": {
      "reviewGuide": [
        {
          "id": "reviewGuide.pullRequests",
          "name": "Pull Requests"
        },
        {
          "id": "reviewGuide.guide",
          "name": "Guide",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "reviewGuide.refresh",
        "title": "Refresh",
        "category": "Review Guide",
        "icon": "$(refresh)"
      },
      {
        "command": "reviewGuide.openPullRequest",
        "title": "Open Pull Request",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.closePullRequest",
        "title": "Close Pull Request",
        "category": "Review Guide",
        "icon": "$(close)"
      },
      {
        "command": "reviewGuide.openUnit",
        "title": "Open Change",
        "category": "Review Guide"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reviewGuide.refresh",
          "when": "view == reviewGuide.pullRequests",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "reviewGuide.closePullRequest",
          "when": "view == reviewGuide.pullRequests && viewItem == openPullRequest",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "reviewGuide.openPullRequest",
          "when": "false"
        },
        {
          "command": "reviewGuide.closePullRequest",
          "when": "false"
        },
        {
          "command": "reviewGuide.openUnit",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Review Guide",
      "properties": {
        "reviewGuide.repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub repositories (owner/name) whose open pull requests are listed. The GitHub repo open in VS Code is always listed."
        },
        "reviewGuide.githubApiUrl": {
          "type": "string",
          "default": "https://api.github.com",
          "description": "GitHub REST API address."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "lint": "eslint src test scripts",
    "test:unit": "mocha --recursive 'out/test/unit/**/*.test.js'",
    "test:integration": "node scripts/run-integration-tests.js",
    "test": "npm run compile && npm run lint && npm run test:unit && npm run test:safety && npm run test:integration",
    "package": "npm run compile && vsce package --out review-guide.vsix",
    "test:safety": "mocha 'out/test/safety/**/*.test.js'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "mocha": "^12.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
