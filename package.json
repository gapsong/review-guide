{
  "name": "review-guide",
  "displayName": "Review Guide",
  "description": "Helps you own your code with Claude: a codemap in the Explorer, a visual explanation per path, and pull requests pre-sorted so you review the critical changes first.",
  "version": "0.4.0",
  "publisher": "gapsong",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gapsong/review-guide.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:.codemap/codemap.yaml",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviewGuide",
          "title": "Review Guide",
          "icon": "media/review-guide.svg"
        }
      ]
    },
    "views": {
      "reviewGuide": [
        {
          "id": "reviewGuide.pullRequests",
          "name": "Pull Requests"
        },
        {
          "id": "reviewGuide.guide",
          "name": "Guide",
          "type": "webview"
        },
        {
          "id": "reviewGuide.ownership",
          "name": "Ownership"
        },
        {
          "id": "reviewGuide.godFiles",
          "name": "God Files"
        }
      ],
      "explorer": [
        {
          "id": "reviewGuide.codemap",
          "name": "Codemap"
        }
      ]
    },
    "commands": [
      {
        "command": "reviewGuide.refresh",
        "title": "Refresh",
        "category": "Review Guide",
        "icon": "$(refresh)"
      },
      {
        "command": "reviewGuide.openPullRequest",
        "title": "Open Pull Request",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.closePullRequest",
        "title": "Close Pull Request",
        "category": "Review Guide",
        "icon": "$(close)"
      },
      {
        "command": "reviewGuide.openUnit",
        "title": "Open Change",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.showProfileDraft",
        "title": "Show Draft Repo Profile",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.startDeepCheck",
        "title": "Start Pass 2 (Deep Check)",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.markRead",
        "title": "Mark as Read",
        "category": "Review Guide",
        "icon": "$(check)"
      },
      {
        "command": "reviewGuide.markUnread",
        "title": "Mark as Unread",
        "category": "Review Guide",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "reviewGuide.explainPath",
        "title": "Explain",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.codemap.open",
        "title": "Open",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.codemap.explain",
        "title": "Explain",
        "category": "Review Guide",
        "icon": "$(book)"
      },
      {
        "command": "reviewGuide.codemap.openStart",
        "title": "Open Where to Start Reading",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.codemap.stillTrue",
        "title": "Still True",
        "category": "Review Guide",
        "icon": "$(check)"
      },
      {
        "command": "reviewGuide.codemap.explainAgain",
        "title": "Explain Again",
        "category": "Review Guide",
        "icon": "$(refresh)"
      },
      {
        "command": "reviewGuide.codemap.ownIt",
        "title": "Own It",
        "category": "Review Guide",
        "icon": "$(target)"
      },
      {
        "command": "reviewGuide.codemap.checkWords",
        "title": "Check My Words",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.codemap.showChanges",
        "title": "Show Changes Since My Check",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.codemap.ownNext",
        "title": "Own Next",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.codemap.showAll",
        "title": "Show All",
        "category": "Review Guide",
        "icon": "$(list-tree)"
      },
      {
        "command": "reviewGuide.codemap.showMoney",
        "title": "Show Money Only",
        "category": "Review Guide",
        "icon": "$(credit-card)"
      },
      {
        "command": "reviewGuide.codemap.showSecurity",
        "title": "Show Security Only",
        "category": "Review Guide",
        "icon": "$(lock)"
      },
      {
        "command": "reviewGuide.codemap.showDeep",
        "title": "Show Deep Modules Only",
        "category": "Review Guide",
        "icon": "$(layers)"
      },
      {
        "command": "reviewGuide.codemap.showUnowned",
        "title": "Show Not Owned Yet",
        "category": "Review Guide",
        "icon": "$(target)"
      },
      {
        "command": "reviewGuide.codemap.openFile",
        "title": "Open Codemap File",
        "category": "Review Guide",
        "icon": "$(go-to-file)"
      },
      {
        "command": "reviewGuide.godFiles.refresh",
        "title": "Refresh God Files",
        "category": "Review Guide",
        "icon": "$(refresh)"
      },
      {
        "command": "reviewGuide.godFiles.open",
        "title": "Open at the Longest Function",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.godFiles.judge",
        "title": "Judge with Claude",
        "category": "Review Guide"
      },
      {
        "command": "reviewGuide.godFiles.showDetails",
        "title": "Show Details",
        "category": "Review Guide"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reviewGuide.refresh",
          "when": "view == reviewGuide.pullRequests",
          "group": "navigation"
        },
        {
          "command": "reviewGuide.codemap.showMoney",
          "when": "view == reviewGuide.codemap && reviewGuide.codemapFilter != money",
          "group": "navigation@1"
        },
        {
          "command": "reviewGuide.codemap.showSecurity",
          "when": "view == reviewGuide.codemap && reviewGuide.codemapFilter != security",
          "group": "navigation@2"
        },
        {
          "command": "reviewGuide.codemap.showDeep",
          "when": "view == reviewGuide.codemap && reviewGuide.codemapFilter != deep",
          "group": "navigation@3"
        },
        {
          "command": "reviewGuide.codemap.showUnowned",
          "when": "view == reviewGuide.codemap && reviewGuide.codemapFilter != unowned",
          "group": "navigation@4"
        },
        {
          "command": "reviewGuide.codemap.showAll",
          "when": "view == reviewGuide.codemap && reviewGuide.codemapFilter != all",
          "group": "navigation@5"
        },
        {
          "command": "reviewGuide.codemap.openFile",
          "when": "view == reviewGuide.codemap && reviewGuide.hasCodemap",
          "group": "2_codemap"
        },
        {
          "command": "reviewGuide.codemap.ownNext",
          "when": "view == reviewGuide.codemap && reviewGuide.hasCodemap",
          "group": "2_codemap"
        },
        {
          "command": "reviewGuide.godFiles.refresh",
          "when": "view == reviewGuide.godFiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "reviewGuide.closePullRequest",
          "when": "view == reviewGuide.pullRequests && viewItem == openPullRequest",
          "group": "inline"
        },
        {
          "command": "reviewGuide.startDeepCheck",
          "when": "view == reviewGuide.pullRequests && viewItem == openPullRequest"
        },
        {
          "command": "reviewGuide.markRead",
          "when": "view == reviewGuide.pullRequests && viewItem =~ /^unit-unread/",
          "group": "inline"
        },
        {
          "command": "reviewGuide.markUnread",
          "when": "view == reviewGuide.pullRequests && viewItem =~ /^unit-(read|understood)/"
        },
        {
          "command": "reviewGuide.codemap.ownIt",
          "when": "view == reviewGuide.codemap && viewItem =~ /^codemapEntry/",
          "group": "inline@2"
        },
        {
          "command": "reviewGuide.codemap.explain",
          "when": "view == reviewGuide.codemap && viewItem =~ /^codemapEntry/",
          "group": "inline@3"
        },
        {
          "command": "reviewGuide.codemap.stillTrue",
          "when": "view == reviewGuide.codemap && viewItem == codemapEntryChanged",
          "group": "inline@1"
        },
        {
          "command": "reviewGuide.codemap.explain",
          "when": "view == reviewGuide.codemap && viewItem =~ /^codemapEntry/",
          "group": "1_codemap@4"
        },
        {
          "command": "reviewGuide.codemap.stillTrue",
          "when": "view == reviewGuide.codemap && viewItem == codemapEntryChanged",
          "group": "1_codemap@2"
        },
        {
          "command": "reviewGuide.codemap.explainAgain",
          "when": "view == reviewGuide.codemap && viewItem == codemapEntryChanged",
          "group": "1_codemap@3"
        },
        {
          "command": "reviewGuide.codemap.ownIt",
          "when": "view == reviewGuide.codemap && viewItem =~ /^codemapEntry/",
          "group": "0_own@1"
        },
        {
          "command": "reviewGuide.codemap.checkWords",
          "when": "view == reviewGuide.codemap && viewItem =~ /^codemapEntry/",
          "group": "0_own@2"
        },
        {
          "command": "reviewGuide.codemap.showChanges",
          "when": "view == reviewGuide.codemap && viewItem =~ /^codemapEntry/",
          "group": "0_own@3"
        },
        {
          "command": "reviewGuide.godFiles.judge",
          "when": "view == reviewGuide.godFiles && viewItem == godFile",
          "group": "0_judge@1"
        },
        {
          "command": "reviewGuide.godFiles.showDetails",
          "when": "view == reviewGuide.godFiles && viewItem == godFile",
          "group": "0_judge@2"
        }
      ],
      "commandPalette": [
        {
          "command": "reviewGuide.openPullRequest",
          "when": "false"
        },
        {
          "command": "reviewGuide.closePullRequest",
          "when": "false"
        },
        {
          "command": "reviewGuide.openUnit",
          "when": "false"
        },
        {
          "command": "reviewGuide.showProfileDraft",
          "when": "false"
        },
        {
          "command": "reviewGuide.startDeepCheck",
          "when": "false"
        },
        {
          "command": "reviewGuide.markRead",
          "when": "false"
        },
        {
          "command": "reviewGuide.markUnread",
          "when": "false"
        },
        {
          "command": "reviewGuide.explainPath",
          "when": "resourceScheme == file"
        },
        {
          "command": "reviewGuide.codemap.open",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.explain",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.openStart",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.showAll",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.showMoney",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.showSecurity",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.showDeep",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.openFile",
          "when": "reviewGuide.hasCodemap"
        },
        {
          "command": "reviewGuide.codemap.stillTrue",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.explainAgain",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.ownIt",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.checkWords",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.showChanges",
          "when": "false"
        },
        {
          "command": "reviewGuide.codemap.ownNext",
          "when": "reviewGuide.hasCodemap"
        },
        {
          "command": "reviewGuide.codemap.showUnowned",
          "when": "false"
        },
        {
          "command": "reviewGuide.godFiles.open",
          "when": "false"
        },
        {
          "command": "reviewGuide.godFiles.judge",
          "when": "false"
        },
        {
          "command": "reviewGuide.godFiles.showDetails",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "reviewGuide.explainPath",
          "group": "reviewGuide"
        }
      ]
    },
    "configuration": {
      "title": "Review Guide",
      "properties": {
        "reviewGuide.repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub repositories (owner/name) whose open pull requests are listed. The GitHub repo open in VS Code is always listed."
        },
        "reviewGuide.githubApiUrl": {
          "type": "string",
          "default": "https://api.github.com",
          "description": "GitHub REST API address."
        },
        "reviewGuide.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Path of the Claude Code CLI (`claude`). It runs logged in with your own Claude subscription."
        },
        "reviewGuide.model": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "Claude model for both passes and the ownership check."
        },
        "reviewGuide.explanationLanguage": {
          "type": "string",
          "default": "English",
          "description": "The language Claude Code writes generated codemap explanations in, for example English or German."
        },
        "reviewGuide.codemapFile": {
          "type": "string",
          "default": ".codemap/codemap.yaml",
          "markdownDescription": "Your codemap, relative to each workspace folder: a YAML list of paths, each with a one-sentence `says`, a `label` (`money`, `security`, `core`, `feature`, `util`), an optional `deep: true` and optional notes (`why`, `watch`, `start`, `mine`). Keep it personal (gitignored)."
        },
        "reviewGuide.godFiles.minLines": {
          "type": "integer",
          "default": 150,
          "minimum": 1,
          "description": "God Files: a source file is ranked from this many code lines on. Code lines are shown, but never part of the score."
        },
        "reviewGuide.godFiles.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "God Files: globs of repo paths to leave out, for example `docs_src/**` or `*_pb2.py`. Tests, generated and vendored code are always left out."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "reviewGuide.codemap",
        "when": "!reviewGuide.hasCodemap",
        "contents": "No codemap in this workspace yet.\nA codemap is your own map of the repo: one sentence and a label (money, security, core, feature, util) for each important file or folder, so you see what matters while you read the code.\nWrite it as a YAML list in .codemap/codemap.yaml (setting: reviewGuide.codemapFile) and keep the .codemap folder out of git.\n[Read how it works](https://github.com/gapsong/review-guide#codemap)"
      },
      {
        "view": "reviewGuide.codemap",
        "when": "reviewGuide.hasCodemap && reviewGuide.codemapFilter != all",
        "contents": "No entry matches this filter.\n[Show All](command:reviewGuide.codemap.showAll)"
      },
      {
        "view": "reviewGuide.codemap",
        "when": "reviewGuide.hasCodemap && reviewGuide.codemapFilter == all",
        "contents": "The codemap has no entry to show. An entry with a problem is left out; the Problems view lists each one on its line.\n[Open Codemap File](command:reviewGuide.codemap.openFile)"
      },
      {
        "view": "reviewGuide.godFiles",
        "contents": "God Files ranks the files of each workspace folder that is a git repo by how many of their names other files use and how often they change, never by length.\nOpen a folder that is a git repo with at least one commit.\n[Read how it works](https://github.com/gapsong/review-guide#god-files)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "lint": "eslint src test scripts",
    "test:unit": "mocha --recursive 'out/test/unit/**/*.test.js'",
    "test:integration": "node scripts/run-integration-tests.js",
    "test": "npm run compile && npm run lint && npm run test:unit && npm run test:safety && npm run test:integration && npm run test:package",
    "package": "npm run compile && vsce package --out review-guide.vsix",
    "test:safety": "mocha 'out/test/safety/**/*.test.js'",
    "test:package": "mocha 'out/test/packaging/**/*.test.js'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "mocha": "^12.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
